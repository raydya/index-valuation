# 本地开发配置；make env 会生成随机密码并写入不提交的 .env。
COMPOSE_PROJECT_NAME=index-valuation
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=index_valuation
POSTGRES_USER=index_valuation
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_CONNECT_TIMEOUT=5

# Futu OpenD：仅调用行情读取接口；需已登录且具有 A 股行情权限。
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
SOURCE_TIMEOUT=20
INDICES_FILE=indices.toml
DATA_DIR=data
