# 共享 PG 连接模板；凭据由 ../local-infra 分配，只保存在不提交的 .env。
COMPOSE_PROJECT_NAME=index-valuation
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=index_valuation
POSTGRES_USER=index_valuation_runtime
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_CONNECT_TIMEOUT=5
# Alembic 独立使用 owner，应用不会读取此连接；URL 密码中的特殊字符需百分号编码。
MIGRATION_DATABASE_URL=postgresql+psycopg://index_valuation_owner:replace-with-migration-password@127.0.0.1:15432/index_valuation
# 集成测试只连接独立测试库，库名必须以 _test 结尾；不允许使用正式库。
# TEST_DATABASE_URL=postgresql+psycopg://index_valuation_test:replace-with-test-password@127.0.0.1:15433/index_valuation_test

# Futu OpenD：仅调用行情读取接口；需已登录且具有 A 股行情权限。
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
SOURCE_TIMEOUT=20
INDICES_FILE=indices.toml
DATA_DIR=data

# Telegram 私聊推送（先配置 token，再运行 scripts/telegram_notify.py bind）。
# 实际凭据只写入本机 .env；勿提交或发送到聊天中。
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=从BotFather获取
# TELEGRAM_CHAT_ID=绑定脚本自动写入的私人会话ID
# 本机若需代理，使用可供定时任务访问的 HTTP(S) 代理地址。
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
